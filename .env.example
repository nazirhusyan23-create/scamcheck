# ---------------------------------------------------------------------------
# ScamCheck — environment variable template
# Copy this file to .env.local for local development, or configure these as
# environment variables in your hosting provider's dashboard for production.
# NEVER commit a real .env / .env.local file — it is gitignored by default.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical URLs, sitemap.xml, robots.txt, and
# Open Graph metadata. Must be publicly accessible (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://scamcheck-nu-flame.vercel.app

# ---------------------------------------------------------------------------
# Google AdSense (optional — leave unset until your AdSense account/site is
# approved). See ADSENSE-READINESS.md for full setup guidance.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-2006445566626425

# ---------------------------------------------------------------------------
# Google Search Console site-verification (the value from your <meta> tag,
# not the whole tag). Renders as a <meta name="google-site-verification">
# tag automatically via app/layout.tsx metadata.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=9bSXV0oYwCNz4T_QT4-FbvCW3bJShIEgX8HZMbep9Co

# ---------------------------------------------------------------------------
# Contact form email delivery (optional). The contact form will honestly
# report itself as "not fully set up" until you configure a provider here
# and wire it up in app/api/contact/route.ts. Example providers: Resend,
# Postmark, AWS SES.
# ---------------------------------------------------------------------------
CONTACT_FORM_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Optional AI enhancement layer (see lib/engine/aiEngine.ts). The product is
# fully functional without this — the local rule engine requires no API key.
# Only set this if you choose to implement the optional AI enhancement hook.
# NEVER expose this key to the client / frontend bundle.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
